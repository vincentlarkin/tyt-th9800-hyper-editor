<Window x:Class="TH9800.HyperEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TH-9800 Hyper Studio" Width="1500" Height="900" MinWidth="1260" MinHeight="760"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="82" />
            <RowDefinition Height="*" />
            <RowDefinition Height="46" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="10" Width="46" Height="46" Margin="0,0,14,0">
                        <Grid>
                            <TextBlock Text="H" Foreground="White" FontWeight="Bold" FontSize="25"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="7" Margin="5" />
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="TH-9800 Hyper Studio" FontSize="24" FontWeight="SemiBold" />
                            <Border Background="#F7E1D8" CornerRadius="9" Padding="8,3" Margin="10,3,0,3">
                                <TextBlock Text="LAB BUILD" Foreground="{StaticResource AccentDarkBrush}" FontSize="10" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="A–F operating profiles without the mystery bytes." Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <Border x:Name="StagedBadge" Grid.Column="1" Background="#E8F3EF" BorderBrush="#B9D9CC"
                        BorderThickness="1" CornerRadius="11" Padding="14,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StagedDot" Width="9" Height="9" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" />
                        <TextBlock x:Name="StagedText" Text="No staged changes" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="244" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="18">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="RADIO CONNECTION" Foreground="#93A4A8" FontSize="10" FontWeight="Bold" Margin="3,2,0,8" />
                        <ComboBox x:Name="PortBox" ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" Margin="0,0,0,10" />
                        <Button x:Name="ReadButton" Click="ReadRadio_Click" Style="{StaticResource AccentButtonStyle}" Padding="14,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↓" FontSize="19" FontWeight="Bold" Margin="0,0,10,0" />
                                <TextBlock Text="Read radio" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Click="RefreshPorts_Click" Style="{StaticResource SidebarButtonStyle}" Padding="14,7">
                            <TextBlock Text="Refresh COM ports" />
                        </Button>

                        <TextBlock Text="IMAGE &amp; LABELS" Foreground="#93A4A8" FontSize="10" FontWeight="Bold" Margin="3,18,0,8" />
                        <Button Click="OpenImage_Click" Style="{StaticResource SidebarButtonStyle}"><TextBlock Text="Open raw image…" /></Button>
                        <Button Click="SaveCopy_Click" Style="{StaticResource SidebarButtonStyle}"><TextBlock Text="Save edited copy…" /></Button>
                        <Button Click="ImportChannels_Click" Style="{StaticResource SidebarButtonStyle}"><TextBlock Text="Import CHIRP labels…" /></Button>

                        <TextBlock Text="BULK ACTIONS" Foreground="#93A4A8" FontSize="10" FontWeight="Bold" Margin="3,18,0,8" />
                        <Button Click="BeepOffAll_Click" Style="{StaticResource SidebarButtonStyle}">
                            <StackPanel>
                                <TextBlock Text="Mute BEEP in all profiles" />
                                <TextBlock Text="A through F" FontSize="10" Foreground="#A8B7BA" />
                            </StackPanel>
                        </Button>
                        <Button Click="FactoryKeys_Click" Style="{StaticResource SidebarButtonStyle}"
                                ToolTip="P1 BAND • P2 VFO/MR • P3 TONE • P4 LOW">
                            <StackPanel>
                                <TextBlock Text="Restore factory P1–P4" />
                                <TextBlock Text="BAND · VFO/MR · TONE · LOW" FontSize="10" Foreground="#A8B7BA" />
                            </StackPanel>
                        </Button>
                        <Button Click="DiscardStaged_Click" Style="{StaticResource SidebarButtonStyle}">
                            <StackPanel>
                                <TextBlock Text="Discard all staged edits" />
                                <TextBlock Text="Return to the loaded image" FontSize="10" Foreground="#A8B7BA" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <Button x:Name="WriteButton" Click="WriteVerify_Click" Style="{StaticResource AccentButtonStyle}" Padding="14,13">
                            <StackPanel>
                                <TextBlock Text="Write + verify" FontWeight="Bold" FontSize="15" />
                                <TextBlock Text="Backup, write, full readback" FontSize="11" Foreground="#FFF0EA" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Keep power and the programming cable steady until verification finishes."
                                   TextWrapping="Wrap" Foreground="#E6BDAF" FontSize="11" Margin="4,3" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="24,22,8,22">
                <StackPanel>
                    <Grid Margin="0,0,16,18">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Hyper Memory profiles" FontSize="25" FontWeight="SemiBold" />
                            <TextBlock Text="Channels, beep, lamp level, and every microphone key assignment saved independently in A–F."
                                       Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#E6F1EE" BorderBrush="#BBD8D1" BorderThickness="1"
                                CornerRadius="10" Padding="12,7" VerticalAlignment="Center">
                            <TextBlock x:Name="ImageBadge" Text="NO IMAGE LOADED" Foreground="{StaticResource TealBrush}" FontWeight="Bold" FontSize="11" />
                        </Border>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}" Width="420" MinHeight="370">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border Width="52" Height="52" CornerRadius="11" Background="#FBE9E2" BorderBrush="#EAB49F" BorderThickness="1">
                                                <TextBlock Text="{Binding Slot}" FontSize="27" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,3,0,0">
                                                <TextBlock Text="Hyper Memory" FontWeight="SemiBold" FontSize="16" />
                                                <TextBlock Text="{Binding Address}" Foreground="{StaticResource MutedBrush}"
                                                           FontFamily="Cascadia Mono, Consolas" FontSize="11" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="#F8F7F3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="8" Padding="10,7" VerticalAlignment="Center">
                                                <CheckBox IsChecked="{Binding Beep}" Content="BEEP" ToolTip="Key beep saved inside this Hyper profile" />
                                            </Border>
                                        </Grid>

                                        <Border Background="{StaticResource SoftSurfaceBrush}" BorderBrush="#E2E5E1" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="LEFT DISPLAY" Style="{StaticResource FieldLabelStyle}" />
                                                    <ComboBox ItemsSource="{Binding DataContext.ChannelOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedValue="{Binding LeftChannel}" SelectedValuePath="Number" DisplayMemberPath="Display" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="RIGHT DISPLAY" Style="{StaticResource FieldLabelStyle}" />
                                                    <ComboBox ItemsSource="{Binding DataContext.ChannelOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedValue="{Binding RightChannel}" SelectedValuePath="Number" DisplayMemberPath="Display" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <StackPanel Margin="0,0,0,14">
                                            <DockPanel>
                                                <TextBlock Text="BACKLIGHT" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBlock Text="{Binding BacklightLabel}" Foreground="{StaticResource AccentBrush}"
                                                           FontWeight="Bold" HorizontalAlignment="Right" />
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True"
                                                    Value="{Binding Backlight}" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <DockPanel Margin="0,0,0,7">
                                            <TextBlock Text="MICROPHONE P1–P4" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="all documented functions" Foreground="{StaticResource TealBrush}" FontSize="10"
                                                       FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        </DockPanel>
                                        <UniformGrid Columns="2" Rows="2">
                                            <Grid Margin="0,0,7,7">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <TextBlock Text="P1" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.KeyOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedValue="{Binding P1}" SelectedValuePath="Value" DisplayMemberPath="Name" />
                                            </Grid>
                                            <Grid Margin="7,0,0,7">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <TextBlock Text="P2" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.KeyOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedValue="{Binding P2}" SelectedValuePath="Value" DisplayMemberPath="Name" />
                                            </Grid>
                                            <Grid Margin="0,0,7,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <TextBlock Text="P3" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.KeyOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedValue="{Binding P3}" SelectedValuePath="Value" DisplayMemberPath="Name" />
                                            </Grid>
                                            <Grid Margin="7,0,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <TextBlock Text="P4" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.KeyOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedValue="{Binding P4}" SelectedValuePath="Value" DisplayMemberPath="Name" />
                                            </Grid>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2" Background="#ECE8DF" BorderBrush="#DDD7CB" BorderThickness="1,0,0,0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Loaded image" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock x:Name="ImagePathText" Text="Read the radio or open an image."
                                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,0" />
                            <Separator Margin="0,12" Background="{StaticResource BorderBrush}" />
                            <TextBlock x:Name="HashText" Text="SHA-256 —" FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock x:Name="ActiveText" Text="Active profile —" Foreground="{StaticResource TealBrush}" FontWeight="SemiBold" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="14">
                        <StackPanel>
                            <TextBlock Text="P1–P4 choices" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Every option available on every Hyper card" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,1,0,7" />
                            <ItemsControl ItemsSource="{Binding KeyOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource AccentDarkBrush}" FontWeight="Bold" FontSize="10" />
                                            <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="{StaticResource MutedBrush}"
                                                       FontSize="10" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0" Padding="16">
                        <TabControl Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource RailTabItemStyle}">
                            <TabItem Header="ACTIVITY">
                                <ListBox ItemsSource="{Binding Activity}" Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Normal" Margin="0,8,0,0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </TabItem>
                            <TabItem Header="INFO &amp; SAFETY">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" FontWeight="Normal" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="WRITE SAFEGUARDS" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="✓ NT_9800 model + size check" Foreground="{StaticResource SuccessBrush}" Margin="0,7,0,0" />
                                        <TextBlock Text="✓ Automatic pre-write clone" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0" />
                                        <TextBlock Text="✓ Full post-write readback" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0" />
                                        <TextBlock Text="✓ Exact SHA-256 comparison" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0" />
                                        <Border Background="#FFF3E5" BorderBrush="#E8C99C" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,10,0,0">
                                            <TextBlock Text="Edits remain local until Write + verify is confirmed. Keep power and cable steady during transfers."
                                                       TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready. Read the radio or open a raw image."
                           VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                <ProgressBar x:Name="Progress" Grid.Column="1" Height="8" Minimum="0" Maximum="100"
                             VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" Background="#E3E6E2" />
            </Grid>
        </Border>
    </Grid>
</Window>
