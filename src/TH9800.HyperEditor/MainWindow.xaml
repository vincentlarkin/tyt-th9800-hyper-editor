<Window x:Class="TH9800.HyperEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TH-9800 Hyper Studio" Width="1320" Height="820" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0D1928" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{StaticResource PrimaryBrush}" CornerRadius="7" Width="34" Height="34" Margin="0,0,12,0">
                            <TextBlock Text="H" Foreground="#08202A" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="TH-9800 Hyper Studio" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Background="#18354A" CornerRadius="10" Padding="9,3" Margin="12,3,0,3">
                            <TextBlock Text="EXPERIMENTAL" Foreground="{StaticResource WarningBrush}" FontSize="10" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Six complete operating profiles, finally visible." Foreground="{StaticResource MutedBrush}" Margin="46,2,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#102D29" BorderBrush="#275E52" BorderThickness="1" CornerRadius="14" Padding="14,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="Source-only • automatic backup • verified readback" Foreground="{StaticResource SuccessBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="246" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="18">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="RADIO" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold" Margin="3,2,0,8" />
                        <ComboBox x:Name="PortBox" ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" Margin="0,0,0,12" />
                        <Button x:Name="ReadButton" Click="ReadRadio_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="↓" FontSize="20" Margin="0,0,10,0"/><TextBlock Text="Read radio" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button Click="RefreshPorts_Click" Padding="14,7"><TextBlock Text="Refresh ports" /></Button>

                        <TextBlock Text="FILES" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold" Margin="3,18,0,8" />
                        <Button Click="OpenImage_Click"><TextBlock Text="Open raw image…" /></Button>
                        <Button Click="SaveCopy_Click"><TextBlock Text="Save edited copy…" /></Button>
                        <Button Click="ImportChannels_Click"><TextBlock Text="Import channel labels…" /></Button>

                        <TextBlock Text="QUICK ACTIONS" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold" Margin="3,18,0,8" />
                        <Button Click="BeepOffAll_Click"><TextBlock Text="Mute BEEP in A–F" /></Button>
                        <Button Click="ScanAll_Click"><TextBlock Text="Set P3-long to SCAN" /></Button>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <Button x:Name="WriteButton" Click="WriteVerify_Click" Background="#77352D" BorderBrush="#C85B4B" Padding="14,13">
                            <StackPanel>
                                <TextBlock Text="Write + verify" FontWeight="Bold" />
                                <TextBlock Text="Backup first, compare after" FontSize="11" Foreground="#FFD4CC" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Never disconnect power or the programming cable during a write." TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" FontSize="11" Margin="4,4" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="24,22,10,22">
                <StackPanel>
                    <Grid Margin="0,0,14,18">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Hyper profiles" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="Each card is a complete A–F snapshot. Channel choices reference existing memories." Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#122D41" CornerRadius="12" Padding="12,7" VerticalAlignment="Center">
                            <TextBlock x:Name="ImageBadge" Text="No image loaded" Foreground="{StaticResource PrimaryBrush}" />
                        </Border>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}" Width="360" MinHeight="270">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border Width="50" Height="50" CornerRadius="12" Background="#173C51" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding Slot}" FontSize="27" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,2,0,0">
                                                <TextBlock Text="Hyper Memory" FontWeight="SemiBold" FontSize="16" />
                                                <TextBlock Text="{Binding Address}" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="11" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="2" IsChecked="{Binding Beep}" Content="BEEP" VerticalAlignment="Center" />
                                        </Grid>

                                        <TextBlock Text="LEFT SIDE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                                        <ComboBox ItemsSource="{Binding DataContext.ChannelOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedValue="{Binding LeftChannel}" SelectedValuePath="Number" DisplayMemberPath="Display" Margin="0,3,0,10" />
                                        <TextBlock Text="RIGHT SIDE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                                        <ComboBox ItemsSource="{Binding DataContext.ChannelOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedValue="{Binding RightChannel}" SelectedValuePath="Number" DisplayMemberPath="Display" Margin="0,3,0,12" />

                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="BACKLIGHT" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Backlight}" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" Width="18" VerticalAlignment="Center" />
                                                    <Slider Minimum="0" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Backlight}" />
                                                </DockPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="P3 LONG" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                                                <ComboBox ItemsSource="{Binding DataContext.P3Options, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedValue="{Binding P3Long}" SelectedValuePath="Value" DisplayMemberPath="Name" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2" Background="#0D1827" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Image health" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock x:Name="ImagePathText" Text="No raw image loaded" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,0" />
                            <Separator Margin="0,12" Background="{StaticResource BorderBrush}" />
                            <TextBlock x:Name="HashText" Text="SHA-256 —" FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock x:Name="ActiveText" Text="Active profile —" Foreground="{StaticResource PrimaryBrush}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Write safeguards" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="✓ Model and image-size validation" Foreground="{StaticResource SuccessBrush}" Margin="0,9,0,0" />
                            <TextBlock Text="✓ Automatic pre-write clone" Foreground="{StaticResource SuccessBrush}" Margin="0,5,0,0" />
                            <TextBlock Text="✓ Full post-write readback" Foreground="{StaticResource SuccessBrush}" Margin="0,5,0,0" />
                            <TextBlock Text="✓ Byte-for-byte SHA comparison" Foreground="{StaticResource SuccessBrush}" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Activity" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <ListBox ItemsSource="{Binding Activity}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#0B1522" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready. Read the radio or open a raw image." VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                <ProgressBar x:Name="Progress" Grid.Column="1" Height="8" Minimum="0" Maximum="100" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}" Background="#18283A" />
            </Grid>
        </Border>
    </Grid>
</Window>
